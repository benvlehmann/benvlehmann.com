---
// Served by GitHub Pages for any address that doesn't exist.
import Base from '../layouts/Base.astro';
import { url } from '../lib/data';
---
<Base title="Page not found" description="This page doesn’t exist.">
  <section>
    <div class="wrap page spacious">
     <div class="narrow">
      <p class="eyebrow">404</p>
      <h1 class="page-title">This page is missing, like most of the matter in the universe.</h1>
      <p class="lede page-lede lead-in">The address may be mistyped, or the page may have moved when the site was rebuilt.</p>
      <p class="actions">
        <a class="pill" href={url('')}>Home</a>
        <a class="pill" href={url('#research')}>Research</a>
        <a class="pill" href={url('people/')}>People</a>
        <a class="pill" href={url('travel/')}>Talks &amp; travel</a>
      </p>
     </div>
    </div>
  </section>
</Base>
