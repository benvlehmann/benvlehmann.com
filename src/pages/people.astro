---
import Base from '../layouts/Base.astro';
import { people, site, url } from '../lib/data';
import { coauthored } from '../lib/inspire';

// Attach papers coauthored with each person, found from INSPIRE at build time.
const withPapers = (list: any[] = []) =>
  Promise.all(list.map(async (p) => ({ ...p, papers: await coauthored(p.name, { inspireName: p.inspire_name, exclude: p.exclude }) })));
const [current, theses, former] = await Promise.all([withPapers(people.current), withPapers(people.theses), withPapers(people.former)]);
const label = (p: any) => p.arxiv ?? 'INSPIRE';
---
<Base title="People" current="people" description="Students and collaborators of Ben Lehmann.">
  <section>
    <div class="wrap page intro">
      <p class="eyebrow">People</p>
      <h1 class="page-title">Students &amp; collaborators</h1>
      <p class="lede page-lede">{people.intro}</p>
      <p class="muted page-note">{people.invite} <a href={site.links.email_page}>Please get in touch.</a></p>
    </div>
  </section>

  {current.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div class="section-head compact">
          <h2 class="subhead">Current students</h2>
          <p>Students whose research I supervise in part or in full.</p>
        </div>
        <ul class="alumni">
          {current.map((s: any) => (
            <li>
              <p class="name">{s.name}</p>
              <p class="thesis">{s.program} student, {s.institution}</p>
              {s.blurb && <p class="thesis">{s.blurb}</p>}
              {(s.papers.length > 0 || s.links) && (
                <p class="links">
                  {s.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}
                  {s.links?.website && <><a href={s.links.website}>website</a>{' '}</>}
                  {s.links?.inspire && <><a href={s.links.inspire}>INSPIRE</a>{' '}</>}
                  {s.links?.orcid && <><a href={s.links.orcid}>ORCID</a>{' '}</>}
                  {s.links?.ads && <a href={s.links.ads}>ADS</a>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap">
      <div class="section-head compact">
        <h2 class="subhead">Undergraduate theses</h2>
        <p>Senior theses I supervised at UC Santa Cruz, and where each student went next.</p>
      </div>
      <ul class="alumni">
        {theses.map((a: any) => (
          <li>
            <p><span class="name">{a.name}</span> <span class="years">{a.years}</span></p>
            <p class="thesis"><em>{a.thesis}</em></p>
            {a.honors && <p class="honors">{a.honors}</p>}
            <p class="next">→ {a.next}</p>
            {(a.papers.length > 0 || a.links) && (
              <p class="links">
                {a.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}
                {a.links?.website && <><a href={a.links.website}>website</a>{' '}</>}
                {a.links?.inspire && <><a href={a.links.inspire}>INSPIRE</a>{' '}</>}
                {a.links?.orcid && <><a href={a.links.orcid}>ORCID</a>{' '}</>}
                {a.links?.ads && <a href={a.links.ads}>ADS</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head compact">
        <h2 class="subhead">Former student collaborators</h2>
        <p>Graduate and undergraduate students I’ve worked with, and where they went next.</p>
      </div>
      <ul class="alumni">
        {former.map((a: any) => (
          <li>
            <p><span class="name">{a.name}</span> <span class="years">{a.years}</span></p>
            <p class="thesis">{a.was}</p>
            <p class="next">→ {a.next}</p>
            {(a.papers.length > 0 || a.links) && (
              <p class="links">
                {a.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}
                {a.links?.website && <><a href={a.links.website}>website</a>{' '}</>}
                {a.links?.inspire && <><a href={a.links.inspire}>INSPIRE</a>{' '}</>}
                {a.links?.orcid && <><a href={a.links.orcid}>ORCID</a>{' '}</>}
                {a.links?.ads && <a href={a.links.ads}>ADS</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap collaborators">
      <h2 class="subhead">Other collaborators</h2>
      <p set:html={people.collaborators} />
      <figure>
        <img src={url(people.group_photo)} alt={people.group_photo_alt} loading="lazy">
        <figcaption>{people.group_photo_caption}</figcaption>
      </figure>
    </div>
  </section>
</Base>
