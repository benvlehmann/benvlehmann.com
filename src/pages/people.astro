---
import Base from '../layouts/Base.astro';
import { people, site, url } from '../lib/data';
import { coauthored } from '../lib/inspire';

// Attach papers coauthored with each person, found from INSPIRE at build time.
const withPapers = (list: any[] = []) =>
  Promise.all(list.map(async (p) => ({ ...p, papers: await coauthored(p.name, { inspireName: p.inspire_name, exclude: p.exclude }) })));
const [current, theses, former] = await Promise.all([withPapers(people.current), withPapers(people.theses), withPapers(people.former)]);
const label = (p: any) => p.arxiv ?? `INSPIRE ${p.inspire}`;
---
<Base title="People" current="people" description="Students and collaborators of Ben Lehmann.">
  <section>
    <div class="wrap" style="padding-block: 40px 64px">
      <p class="eyebrow">People</p>
      <h1 class="page-title">Students &amp; collaborators</h1>
      <p class="lede" style="max-width: 40em; margin: 0 0 14px">{people.intro}</p>
      <p class="muted" style="max-width: 40em; margin: 0">{people.invite} <a href={site.links.email_page}>Please get in touch.</a></p>
    </div>
  </section>

  {current.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div class="section-head" style="margin-bottom: 28px">
          <h2 style="font-size: 40px">Current students</h2>
          <p>Students whose research I supervise in part or in full.</p>
        </div>
        <ul class="alumni">
          {current.map((s: any) => (
            <li>
              <p class="name">{s.name}</p>
              <p class="thesis">{s.program} student, {s.institution}</p>
              {s.blurb && <p class="thesis">{s.blurb}</p>}
              {s.papers.length > 0 && (
                <p class="links">{s.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 28px">
        <h2 style="font-size: 40px">Undergraduate theses</h2>
        <p>Senior theses I supervised at UC Santa Cruz, and where each student went next.</p>
      </div>
      <ul class="alumni">
        {theses.map((a: any) => (
          <li>
            <p><span class="name">{a.name}</span> <span class="mono faint" style="font-size: var(--fs-mono)">{a.years}</span></p>
            <p class="thesis"><em>{a.thesis}</em></p>
            {a.honors && <p class="thesis faint" style="font-size: var(--fs-fine)">{a.honors}</p>}
            <p class="next">→ {a.next}</p>
            {(a.papers.length > 0 || a.links) && (
              <p class="links">
                {a.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}
                {a.links?.website && <><a href={a.links.website}>website</a>{' '}</>}
                {a.links?.inspire && <a href={a.links.inspire}>INSPIRE</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 28px">
        <h2 style="font-size: 40px">Former student collaborators</h2>
        <p>Graduate and undergraduate students I’ve worked with, and where they went next.</p>
      </div>
      <ul class="alumni">
        {former.map((a: any) => (
          <li>
            <p><span class="name">{a.name}</span> <span class="mono faint" style="font-size: var(--fs-mono)">{a.years}</span></p>
            <p class="thesis">{a.was}</p>
            <p class="next">→ {a.next}</p>
            {(a.papers.length > 0 || a.links) && (
              <p class="links">
                {a.papers.map((p: any) => <><a href={p.url} title={p.title}>{label(p)}</a>{' '}</>)}
                {a.links?.website && <><a href={a.links.website}>website</a>{' '}</>}
                {a.links?.inspire && <a href={a.links.inspire}>INSPIRE</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 style="font-size: 40px; margin-bottom: 20px">Other collaborators</h2>
      <p style="margin: 0 0 32px; max-width: 44em; color: var(--text-2)" set:html={people.collaborators} />
      <figure style="margin: 0; max-width: 760px">
        <img src={url(people.group_photo)} alt={people.group_photo_alt} loading="lazy" style="display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px">
        <figcaption>{people.group_photo_caption}</figcaption>
      </figure>
    </div>
  </section>
</Base>
