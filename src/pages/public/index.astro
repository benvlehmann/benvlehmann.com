---
import Base from '../../layouts/Base.astro';
import { posts, formatDate } from '../../lib/posts';
import { url } from '../../lib/data';
---
<Base title="Posts">
  <section>
    <div class="wrap post page">
      <p class="eyebrow">Posts</p>
      <ol class="rows">
        {posts.map((p) => (
          <li>
            <span class="when">{formatDate(p.date)}</span>
            <span class="what"><a href={url(`public/${p.slug}/`)}>{p.title}</a></span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
