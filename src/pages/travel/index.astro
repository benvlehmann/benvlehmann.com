---
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/data';
import { splitTrips, formatRange } from '../../lib/travel';

const { upcoming, past } = await splitTrips();
const years = new Map<string, typeof past>();
for (const t of past) {
  const y = t.start.slice(0, 4);
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(t);
}
---
<Base title="Talks & travel" current="travel" description="Talks, seminars, conferences and visits by Ben Lehmann.">
  <section>
    <div class="wrap page intro">
      <h1 class="page-title">Talks &amp; travel</h1>
      {upcoming.length > 0 && (
        <div class="box solo">
          <p class="label accent">Upcoming</p>
          <ul>
            {upcoming.map((t) => (
              <li><span class="when">{formatRange(t.start, t.end)}</span>{t.title}{t.place && <span class="faint"> · {t.place}</span>}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      {[...years].map(([y, trips]) => (
        <>
          <h2 class="year">{y}</h2>
          <ol class="rows tight">
            {trips.map((t) => (
              <li id={t.slug}>
                <span class="when">{formatRange(t.start, t.end)}</span>
                <span class="what">{t.title}{t.place && <span class="faint"> · {t.place}</span>}</span>
              </li>
            ))}
          </ol>
        </>
      ))}
    </div>
  </section>
</Base>
